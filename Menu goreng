<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pencatatan Total Indra & Aguan</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #f4f6f9;
            padding: 15px;
            margin: 0;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        h2 {
            text-align: center;
            color: #333;
            margin-top: 0;
        }
        .form-group {
            margin-bottom: 12px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }
        input[type="date"],
        input[type="number"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 16px; /* Mencegah auto-zoom di Android */
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }
        button:active {
            background-color: #0056b3;
        }
        .table-responsive {
            overflow-x: auto;
            margin-top: 25px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
            font-size: 14px;
        }
        th {
            background-color: #f2f2f2;
            color: #333;
        }
        tr.total-row {
            font-weight: bold;
            background-color: #e9ecef;
        }
        .btn-delete {
            background-color: #dc3545;
            padding: 5px 10px;
            font-size: 12px;
            width: auto;
            margin: 0;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Input Data Harian</h2>
    
    <!-- Form Input Manual -->
    <div class="form-group">
        <label for="tanggal">Tanggal:</label>
        <input type="date" id="tanggal">
    </div>
    <div class="form-group">
        <label for="indra">Indra (Rp):</label>
        <input type="number" id="indra" placeholder="Masukkan nominal Indra">
    </div>
    <div class="form-group">
        <label for="aguan">Aguan (Rp):</label>
        <input type="number" id="aguan" placeholder="Masukkan nominal Aguan">
    </div>
    
    <button onclick="tambahData()">Simpan Data</button>

    <!-- Tabel Data dan Total -->
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Tanggal</th>
                    <th>Indra</th>
                    <th>Aguan</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody id="data-rows">
                <!-- Baris data akan muncul di sini via JS -->
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td>TOTAL</td>
                    <td id="total-indra">0</td>
                    <td id="total-aguan">0</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<script>
    // Set default tanggal hari ini di input
    document.getElementById('tanggal').valueAsDate = new Date();

    // Load data awal dari Local Storage saat halaman dibuka
    let dataList = JSON.parse(localStorage.getItem('dataKeuangan')) || [];
    perbaruiTabel();

    function tambahData() {
        const tglInput = document.getElementById('tanggal').value;
        const indraInput = parseFloat(document.getElementById('indra').value) || 0;
        const aguanInput = parseFloat(document.getElementById('aguan').value) || 0;

        if (!tglInput) {
            alert("Silakan pilih tanggal terlebih dahulu!");
            return;
        }

        // Format tanggal ke tampilan Indonesia (DD/MM/YYYY)
        const tglFormat = tglInput.split('-').reverse().join('/');

        // Buat objek data baru
        const dataBaru = {
            id: Date.now(),
            tanggal: tglFormat,
            indra: indraInput,
            aguan: aguanInput
        };

        // Masukkan ke array dan simpan ke Local Storage
        dataList.push(dataBaru);
        localStorage.setItem('dataKeuangan', JSON.stringify(dataList));

        // Reset input form nominal
        document.getElementById('indra').value = '';
        document.getElementById('aguan').value = '';

        // Perbarui tampilan tabel
        perbaruiTabel();
    }

    function hapusData(id) {
        if(confirm("Hapus baris data ini?")) {
            dataList = dataList.filter(item => item.id !== id);
            localStorage.setItem('dataKeuangan', JSON.stringify(dataList));
            perbaruiTabel();
        }
    }

    function perbaruiTabel() {
        const tbody = document.getElementById('data-rows');
        tbody.innerHTML = '';

        let totalIndra = 0;
        let totalAguan = 0;

        // Susun baris data tabel
        dataList.forEach(item => {
            totalIndra += item.indra;
            totalAguan += item.aguan;

            const row = `<tr>
                <td>${item.tanggal}</td>
                <td>${item.indra.toLocaleString('id-ID')}</td>
                <td>${item.aguan.toLocaleString('id-ID')}</td>
                <td><button class="btn-delete" onclick="hapusData(${item.id})">Hapus</button></td>
            </tr>`;
            tbody.innerHTML += row;
        });

        // Tampilkan total di baris paling bawah
        document.getElementById('total-indra').innerText = totalIndra.toLocaleString('id-ID');
        document.getElementById('total-aguan').innerText = totalAguan.toLocaleString('id-ID');
    }
</script>

</body>
</html>

